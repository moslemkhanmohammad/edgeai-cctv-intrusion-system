# cctv_fixed/Dockerfile.gateway
FROM python:3.11-slim

RUN apt-get update && apt-get install -y libglib2.0-0 && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY cctv_fixed/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

COPY cctv_fixed/ /app/

# Gateway باید فایل‌های فریم را ببیند؛ از همان ولوم استفاده می‌کند
EXPOSE 8089
CMD ["uvicorn", "fastapi_gateway:app", "--host", "0.0.0.0", "--port", "8089"]
