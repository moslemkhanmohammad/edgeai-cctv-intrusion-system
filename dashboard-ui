# cctv_fixed/Dockerfile.dashboard
FROM python:3.11-slim

RUN apt-get update && apt-get install -y libglib2.0-0 && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY cctv_fixed/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

COPY cctv_fixed/ /app/

EXPOSE 8501
# توجه: اگر آدرس‌ها را به gateway تغییر دهید:
# STREAM_SNAPSHOT_URL = "http://gateway:8089/snapshot.jpg"
CMD ["streamlit", "run", "dashboard_web.py", "--server.address=0.0.0.0", "--browser.gatherUsageStats=false"]
