# cctv_fixed/Dockerfile.ai
FROM python:3.11-slim

# System deps for OpenCV and image I/O
RUN apt-get update && apt-get install -y \
    ffmpeg libsm6 libxext6 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY cctv_fixed/requirements.txt /app/requirements.txt
# اگر requirements ندارید، حداقل موارد لازم:
# ultralytics opencv-python pillow numpy requests plyer streamlit-image-coordinates fastapi uvicorn
RUN pip install --no-cache-dir -r requirements.txt

COPY cctv_fixed/ /app/

# ولوم‌های مشترک برای خروجی‌ها و کانفیگ زون
VOLUME ["/app/alerts", "/app"]

# متغیرهای محیطی مثلا RTSP_URL
ENV RTSP_URL=person-bicycle-car-detection.mp4

# اجرای موتور AI
CMD ["python", "run_ai.py"]
